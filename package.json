{
  "name": "tabherd",
  "version": "0.3.2",
  "description": "A dashboard for your Claude Code sessions: which ones need you, which are working, and what they last said",
  "private": true,
  "main": "server.js",
  "bin": {
    "tabherd": "server.js"
  },
  "scripts": {
    "start": "node server.js --open",
    "serve": "node server.js",
    "check": "node server.js --once",
    "setup": "node scripts/gitflow.js setup",
    "setup-github": "node scripts/gitflow.js github",
    "test": "node --test",
    "build": "node scripts/build-release.js",
    "install-shortcut": "node scripts/install-shortcut.js",
    "uninstall-shortcut": "node scripts/install-shortcut.js --uninstall",
    "check-terminals": "node scripts/check-terminals.js",
    "icons": "node scripts/icons.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "GPL-3.0-or-later"
}
