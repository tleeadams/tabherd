{
  "name": "tabherd",
  "version": "0.6.1",
  "description": "A dashboard for your Claude Code and Codex sessions: which ones need you, which are working, and what they last said",
  "keywords": [
    "claude-code",
    "codex",
    "dashboard",
    "agents"
  ],
  "homepage": "https://github.com/tleeadams/tabherd#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tleeadams/tabherd.git"
  },
  "bugs": "https://github.com/tleeadams/tabherd/issues",
  "main": "server.js",
  "bin": {
    "tabherd": "launcher/npm.js"
  },
  "files": [
    "server.js",
    "lib/",
    "public/",
    "launcher/npm.js",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "node server.js --open",
    "serve": "node server.js",
    "check": "node server.js --once",
    "setup": "node scripts/gitflow.js setup",
    "setup-github": "node scripts/gitflow.js github",
    "test": "node --test",
    "build": "node scripts/build-release.js",
    "install-shortcut": "node scripts/install-shortcut.js",
    "uninstall-shortcut": "node scripts/install-shortcut.js --uninstall",
    "check-terminals": "node scripts/check-terminals.js",
    "check-package": "node scripts/check-package.js",
    "icons": "node scripts/icons.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "GPL-3.0-or-later"
}
