<?xml version="1.0" encoding="utf-8"?>
<!--
  The artifact configuration for the project on SignPath, kept here so changes
  to it are reviewed like code. Paste it into the project's default artifact
  configuration on signpath.io.

  The Release workflow uploads only the app, Tabherd.exe, so the artifact
  GitHub makes is a zip holding that one file.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="Tabherd.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
